# =====================================================================
# TraveXperience Backend — plantilla de variables de entorno
# Copia a .env y completa. NUNCA subas el .env real al repositorio.
# =====================================================================

# --- General ----------------------------------------------------------
NODE_ENV=development            # en Render: production
PORT=4000
# URL pública del backend INCLUYENDO /api/v1 (se usa para armar enlaces).
# En producción debe ser https. Ej.: https://backend-travexperience.onrender.com/api/v1
API_PUBLIC_URL=http://localhost:4000/api/v1
# URL pública del frontend (enlaces de correo: reset de contraseña, etc.)
FRONTEND_PUBLIC_URL=http://localhost:5173

# --- CORS (PWA) -------------------------------------------------------
# Orígenes permitidos, separados por comas, SIN barra final.
# En desarrollo se permite además http://localhost:5173 automáticamente.
# En producción es OBLIGATORIO: sin esto el navegador bloquea la API.
CORS_ORIGINS=https://tu-frontend.onrender.com

# --- Datos abiertos (OpenStreetMap / Wikimedia) -------------------------
# User-Agent identificable con un contacto real (política de Nominatim,
# Overpass y Wikimedia). Lo usan geocodingService y los scripts.
OSM_USER_AGENT=TraveXperience/1.0 (tu-correo@dominio.com)
# Opcionales (por defecto, los servidores públicos):
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- MySQL (usuarios, itinerarios, pagos) ------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=travexperience
MYSQL_USER=
MYSQL_PASSWORD=

# --- MongoDB (lugares, hoteles, reseñas, logs) --------------------------
MONGO_URI=mongodb://localhost:27017/travexperience

# --- Seguridad ----------------------------------------------------------
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- Google Sign-In ("Continuar con Google") ----------------------------
# Solo inicio de sesión (OAuth). NO es Google Maps/Places.
# Mismo Client ID que VITE_GOOGLE_CLIENT_ID en el frontend.
GOOGLE_CLIENT_ID=

# --- IA (TensorFlow.js) ---------------------------------------------------
AI_MODEL_CLUSTERING_PATH=./src/ai-models/clustering-model/model.json
AI_MODEL_BUDGET_PATH=./src/ai-models/budget-prediction-model/model.json

# --- Wearable -------------------------------------------------------------
WEARABLE_ACTIVE_WINDOW_MINUTES=180

# --- Clima (OpenWeatherMap) -----------------------------------------------
OPENWEATHER_API_KEY=

# --- Pagos (Stripe) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Correo (SMTP) ------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=TraveXperience
MAIL_FROM_EMAIL=
